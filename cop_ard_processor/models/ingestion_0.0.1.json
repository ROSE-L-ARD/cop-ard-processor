{
  "available_modes": ["default"],
  "default_mode": "default",
  "modes_config": {
    "default": {
      "inputs": {},
      "adfs": {
        "REFDB": {
          "min_occurs": 1,
          "spec": {}
        },
        ".*ETAD.*": {
          "min_occurs": 0,
          "spec": {}
        },
        ".*ORB.*": {
          "min_occurs": 0,
          "spec": {}
        }
      },
      "outputs": {},
      "parameters": {
        "input_slcs_files": {
          "required": true
        },
        "calibration_type": {
          "required": false,
          "value_type": "str",
          "allowed_values": ["SigmaZero", "BetaZero", "GammaZero"]
        },
        "enable_dask": {
          "required": false,
          "value_type": "bool"
        },
        "recompute": {
          "required": false,
          "value_type": "bool"
        },
        "deramp": {
          "required": false,
          "value_type": "bool"
        },
        "noise_removal": {
          "required": false,
          "value_type": "bool"
        },
        "apply_invalid_mask": {
          "required": false,
          "value_type": "bool"
        },
        "schema_validation": {
          "required": false,
          "value_type": "bool"
        },
        "chunks": {
          "required": false
        },
        "indices": {
          "required": false
        },
        "polarization": {
          "required": false
        },
        "reference_id": {
          "required": false,
          "value_type": "str",
          "pattern": ".+"
        },
        "facility": {
          "required": false,
          "value_type": "str"
        }
      }
    }
  }
}
